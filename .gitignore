# ===========================================================================
# 次元模仓 · 仓库级忽略规则
# 说明：所有「含密钥 / 本地产物 / 内部工具」一律不入库，只提交代码与模板。
# ===========================================================================

# ---- 环境变量（含数据库口令、邮箱授权码、管理员口令等，绝不提交）----
.env
.env.*
!.env.example

# ---- 密钥 / 证书（JWT 密钥等，绝不提交）----
*.key
secret.key
*.pem
cert.pem
key.pem

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# ---- Node ----
node_modules/
dist/
dist-ssr/
coverage/
.npm-cache/

# ---- 运行时产物（Redis 快照 / 日志）----
dump.rdb
*.log
logs/

# ---- 本仓库内部工具与备份（非交付代码）----
.workbuddy/
*.bak
*.bak.*

# ---- 编辑器 / 系统 ----
.idea/
.DS_Store
Thumbs.db
