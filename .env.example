# ===========================================================================
# 次元模仓 · 环境变量模板（可提交，不含任何真实值）
# ---------------------------------------------------------------------------
# 使用方式：复制本文件为 .env 并填入真实值 → cp .env.example .env
#   · 后端：Flask 启动时由 python-dotenv 自动读取项目根目录 .env
#   · 脚本：start-services.ps1 解析同一份 .env
#   · 前端：Vite 读取同一份 .env，仅 VITE_ 前缀的变量会注入浏览器
# ⚠️ 真实 .env 已被 .gitignore 忽略，请勿把真实密钥写进本模板文件。
# ===========================================================================

# ----------------------------- 数据库（MySQL） -----------------------------
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:<你的root密码>@127.0.0.1:3306/vue_db

# ----------------------------- Redis / Celery -----------------------------
# Flask、Celery 共用同一个 Redis：/0 做缓存，/1 做任务队列
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ----------------------------- JWT -----------------------------
# 留空则后端自动生成随机密钥并持久化到 Flask/jwt.key（不入库）
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# ----------------------------- 历史密码密钥（务必备份） -----------------------------
# 老账号的密码是 Fernet 密文，必须靠这个密钥才能校验；
# 换掉 / 丢失 = 这些账号永久无法登录。留空则回退读取 Flask/secret.key。
FERNET_KEY=

# ----------------------------- 管理员账号 -----------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ----------------------------- 邮件（QQ 邮箱 SMTP） -----------------------------
# SMTP_PASSWORD 是邮箱「授权码」，不是 QQ 登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------- 智谱 AI 客服（可选） -----------------------------
# 留空则 AI 客服降级为本地兜底回复
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ----------------------------- MinIO 对象存储（商品图片） -----------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_ADDRESS=127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=goods-images
MINIO_SECURE=false

# ----------------------------- CORS 允许来源 -----------------------------
# Vite 开发服务器(5173) 直连后端时放行；走 Vite 代理时不涉及 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------- 调度器 -----------------------------
SCHEDULER_TIMEZONE=Asia/Shanghai

# ----------------------------- 一键脚本用（start-services.ps1） -----------------------------
# VENV_PYTHON：跑 Celery 的解释器，应与 PyCharm 里跑 Flask 的保持同一个
VENV_PYTHON=
# 中间件可执行文件；留空则脚本自动探测
REDIS_BIN=
MINIO_BIN=
MINIO_DATA=

# ----------------------------- 前端（Vite，仅 VITE_ 前缀会注入浏览器） -----------------------------
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_MINIO_PROXY_TARGET=http://127.0.0.1:9000
# 扫码支付为演示占位（本地无真实支付网关），本地走页面上的「模拟支付」
VITE_PAY_GATEWAY_URL=http://localhost:5173

# ----------------------------- Elasticsearch（可选，不可用自动降级 MySQL） -----------------------------
ES_HOST=127.0.0.1
ES_PORT=9200
